ARG BASE_IMAGE=us-central1-docker.pkg.dev/talkowski-sv-gnomad/kj-dockers/utils:latest
FROM ${BASE_IMAGE}

MAINTAINER Karan Jaisingh

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    pkg-config \
    libcurl4-gnutls-dev \
    automake \
    libtool \
    && rm -rf /var/lib/apt/lists/*

ARG SETUPTOOLS_VERSION
ARG CIGAR_VERSION
ARG NUMPY_VERSION
ARG PYSAM_VERSION
ARG BIOPYTHON_VERSION
ARG PANDAS_VERSION
ARG SCIPY_VERSION
ARG MAPPY_VERSION
ARG PYBEDTOOLS_VERSION
ARG SCIKIT_LEARN_VERSION
RUN pip3 install --no-cache-dir "setuptools==${SETUPTOOLS_VERSION}" && \
    pip3 install --no-cache-dir --no-build-isolation "cigar==${CIGAR_VERSION}" && \
    pip3 install --no-cache-dir \
    "numpy==${NUMPY_VERSION}" \
    "pysam==${PYSAM_VERSION}" \
    "biopython==${BIOPYTHON_VERSION}" \
    "pandas==${PANDAS_VERSION}" \
    "scipy==${SCIPY_VERSION}" \
    "mappy==${MAPPY_VERSION}" \
    "pybedtools==${PYBEDTOOLS_VERSION}" \
    "scikit-learn==${SCIKIT_LEARN_VERSION}"

# Install BWA
ARG BWA_COMMIT
RUN cd /opt && \
    git clone https://github.com/lh3/bwa.git && \
    cd bwa && \
    git checkout ${BWA_COMMIT} && \
    make

ENV PATH="/opt/bwa:${PATH}"

# Install minimap2
ARG MINIMAP2_COMMIT
ARG K8_VERSION
RUN cd /opt && \
    git clone https://github.com/lh3/minimap2.git && \
    cd minimap2 && \
    git checkout ${MINIMAP2_COMMIT} && \
    make && \
    curl -L https://github.com/attractivechaos/k8/releases/download/v${K8_VERSION}/k8-${K8_VERSION}.tar.bz2 | tar -jxf - && \
    cp k8-${K8_VERSION}/k8-`uname -s` k8

ENV PATH="/opt/minimap2:/opt/minimap2/misc:${PATH}"

# Install TRF
ARG TRF_COMMIT
RUN cd /opt && \
    git clone https://github.com/Benson-Genomics-Lab/TRF.git && \
    cd TRF && \
    git checkout ${TRF_COMMIT} && \
    autoreconf -fi && \
    mkdir build && \
    cd build && \
    ../configure && \
    make && \
    cp src/trf /usr/local/bin/trf

# Install SVAN
ARG SVAN_COMMIT
RUN mkdir -p /app && \
    cd /app && \
    git clone https://github.com/REPBIO-LAB/SVAN.git && \
    git -C SVAN checkout ${SVAN_COMMIT}

ENV PYTHONPATH="/app/SVAN:/app/SVAN/GAPI:${PYTHONPATH}"
