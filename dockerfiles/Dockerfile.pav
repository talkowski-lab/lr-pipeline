ARG BASE_IMAGE=us-central1-docker.pkg.dev/talkowski-sv-gnomad/kj-dockers/utils:latest
FROM ${BASE_IMAGE}

MAINTAINER Karan Jaisingh

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    software-properties-common \
    pkg-config \
    libcurl4-gnutls-dev \
    libncurses5-dev \
    libgdbm-dev \
    libc6-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python 3.12 (deadsnakes PPA, so the patch version follows the PPA and cannot be pinned)
RUN add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && \
    apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.12 as default for python3 and python
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --set python3 /usr/bin/python3.12 && \
    ln -s /usr/bin/python3 /usr/bin/python

# Install pip for Python 3.12
ARG SETUP_PIP_VERSION
RUN curl -sSo /tmp/get-pip.py https://bootstrap.pypa.io/get-pip.py \
    && python3 /tmp/get-pip.py "pip==${SETUP_PIP_VERSION}" \
    && rm /tmp/get-pip.py

# Install samtools (GCS/S3-enabled, matching Utils' htslib build)
ARG SAMTOOLS_VERSION
RUN wget -q https://github.com/samtools/samtools/releases/download/${SAMTOOLS_VERSION}/samtools-${SAMTOOLS_VERSION}.tar.bz2 \
    && tar xjf samtools-${SAMTOOLS_VERSION}.tar.bz2 \
    && rm samtools-${SAMTOOLS_VERSION}.tar.bz2 \
    && cd samtools-${SAMTOOLS_VERSION} \
    && ./configure --enable-libcurl --enable-gcs --enable-s3 \
    && make \
    && make install \
    && make clean

# Install Minimap2
ARG MINIMAP2_COMMIT
ARG K8_VERSION
RUN cd /opt && \
    git clone https://github.com/lh3/minimap2.git && \
    cd minimap2 && \
    git checkout ${MINIMAP2_COMMIT} && \
    make && \
    curl -L https://github.com/attractivechaos/k8/releases/download/v${K8_VERSION}/k8-${K8_VERSION}.tar.bz2 | tar -jxf - && \
    cp k8-${K8_VERSION}/k8-`uname -s` k8

ENV PATH="/opt/minimap2:/opt/minimap2/misc:${PATH}"

# Install PAV and dependencies
ARG PAV_VERSION
ARG SNAKEMAKE_VERSION
ARG DRMAA_VERSION
ARG JOBLIB_VERSION
ARG PULP_VERSION
ARG MATPLOTLIB_VERSION
ARG MATPLOTLIB_VENN_VERSION
ARG PANDAS_VERSION
ARG PYSAM_VERSION
# pav3 calls APIs removed in polars 2.0 (pl.count(), Expr.flatten) but leaves polars unbounded
ARG POLARS_VERSION
RUN python3 -m pip install --no-cache-dir \
    "pav3==${PAV_VERSION}" \
    "snakemake==${SNAKEMAKE_VERSION}" \
    "drmaa==${DRMAA_VERSION}" \
    "joblib==${JOBLIB_VERSION}" \
    "pulp==${PULP_VERSION}" \
    "matplotlib==${MATPLOTLIB_VERSION}" \
    "matplotlib-venn==${MATPLOTLIB_VENN_VERSION}" \
    "pandas==${PANDAS_VERSION}" \
    "pysam==${PYSAM_VERSION}" \
    "polars==${POLARS_VERSION}"
