ARG BASE_IMAGE=us-central1-docker.pkg.dev/talkowski-sv-gnomad/kj-dockers/utils:latest
FROM ${BASE_IMAGE}

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install VRS
ARG SETUP_PIP_VERSION
ARG VRS_VERSION
RUN pip install --no-cache-dir "pip==${SETUP_PIP_VERSION}" && \
    pip install --no-cache-dir "ga4gh.vrs[extras]==${VRS_VERSION}"
