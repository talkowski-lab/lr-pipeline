ARG BASE_IMAGE=us-central1-docker.pkg.dev/talkowski-sv-gnomad/kj-dockers/trgt:latest
FROM ${BASE_IMAGE}

# Install trgt-lps
ARG TRGT_LPS_VERSION
RUN wget https://github.com/PacificBiosciences/trgt-lps/releases/download/${TRGT_LPS_VERSION}/trgt-lps-v${TRGT_LPS_VERSION}.gz -O /usr/bin/trgt-lps.gz && \
    gunzip /usr/bin/trgt-lps.gz && \
    chmod +x /usr/bin/trgt-lps

# Verify installation
RUN trgt-lps --help
