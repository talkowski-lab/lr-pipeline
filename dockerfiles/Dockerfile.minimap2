ARG BASE_IMAGE=us-central1-docker.pkg.dev/talkowski-sv-gnomad/kj-dockers/utils:latest
FROM ${BASE_IMAGE}

MAINTAINER Karan Jaisingh

ENV DEBIAN_FRONTEND=noninteractive

# Install samtools at Utils' htslib version, since Utils' apt samtools 1.13 runs against htslib 1.20 and fails sorting assembly contigs over ~100 Mb
ARG SAMTOOLS_VERSION
RUN wget -q https://github.com/samtools/samtools/releases/download/${SAMTOOLS_VERSION}/samtools-${SAMTOOLS_VERSION}.tar.bz2 \
    && tar xjf samtools-${SAMTOOLS_VERSION}.tar.bz2 \
    && rm samtools-${SAMTOOLS_VERSION}.tar.bz2 \
    && cd samtools-${SAMTOOLS_VERSION} \
    && ./configure --enable-libcurl --enable-gcs --enable-s3 \
    && make \
    && make install \
    && make clean

# Install minimap2
ARG MINIMAP2_VERSION
RUN wget -q https://github.com/lh3/minimap2/releases/download/v${MINIMAP2_VERSION}/minimap2-${MINIMAP2_VERSION}_x64-linux.tar.bz2 \
    && tar --no-same-owner -xjf minimap2-${MINIMAP2_VERSION}_x64-linux.tar.bz2 \
    && mv minimap2-${MINIMAP2_VERSION}_x64-linux/minimap2 /usr/local/bin/ \
    && mv minimap2-${MINIMAP2_VERSION}_x64-linux/k8 /usr/local/bin/ \
    && mv minimap2-${MINIMAP2_VERSION}_x64-linux/paftools.js /usr/local/bin/ \
    && rm -rf minimap2-${MINIMAP2_VERSION}_x64-linux* \
    && minimap2 --version
