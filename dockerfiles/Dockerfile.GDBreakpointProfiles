# Genomic-disorder breakpoint profiles: per-window depth/BAF/GT extraction (local or gs://, requester pays, via pysam) and
# per-locus BAF loss scan, LD and plots. Build from the repository root:
#   podman build --platform linux/amd64 -f dockerfiles/Dockerfile.GDBreakpointProfiles -t <registry>/gd-breakpoint-profiles:<tag> .
FROM rocker/r-ver:4.4.1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip tabix bcftools curl fontconfig fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir pysam==0.23.0 pandas==2.2.3 numpy==1.26.4
RUN install2.r --error --skipinstalled ggplot2 data.table R.utils optparse patchwork

COPY wdl_analyses/gd_breakpoint_profiles /opt/gd_scripts
RUN chmod +x /opt/gd_scripts/*.sh /opt/gd_scripts/*.py /opt/gd_scripts/*.R
