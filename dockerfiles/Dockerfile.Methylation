FROM python:3.11-slim

MAINTAINER Yossi Mostovoy

# tabix/bgzip for the per-site stats table; scientific Python stack for QC and plotting.
RUN apt-get update && apt-get install -y --no-install-recommends \
        tabix && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        "numpy>=1.26,<3" "pandas>=2.1,<3" "matplotlib>=3.8,<4" && \
    python3 -c "import numpy, pandas, matplotlib"

COPY ./scripts/methylation/methylation_qc.py /opt/gnomad-lr/scripts/methylation/methylation_qc.py

# Build from the repository root so the COPY path resolves, e.g.:
#   docker build -f dockerfiles/Dockerfile.Methylation -t quay.io/ymostovoy/lr-methylation:latest .
