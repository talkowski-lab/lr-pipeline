ARG BASE_IMAGE=us-central1-docker.pkg.dev/talkowski-sv-gnomad/kj-dockers/utils:latest
FROM ${BASE_IMAGE}

MAINTAINER Karan Jaisingh

ENV DEBIAN_FRONTEND=noninteractive

# Install Rust
ARG RUST_VERSION
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION}
ENV PATH="/root/.cargo/bin:${PATH}"

# Build kanpig
ARG KANPIG_VERSION
RUN wget -q https://github.com/ACEnglish/kanpig/archive/refs/tags/v${KANPIG_VERSION}.tar.gz \
    && tar xzf v${KANPIG_VERSION}.tar.gz \
    && rm v${KANPIG_VERSION}.tar.gz \
    && cd kanpig-${KANPIG_VERSION} \
    && cargo build --release \
    && mv target/release/kanpig /usr/local/bin/ \
    && cd .. \
    && rm -rf kanpig-${KANPIG_VERSION}
